{
  "name": "Ops Inbox: validate and explain (demo data)",
  "nodes": [
    {
      "id": "b1f0c6c2-0001-4a11-9a01-000000000001",
      "name": "New CSV in Ops Inbox",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "triggerOn": "specificFolder",
        "folderToWatch": { "__rl": true, "value": "REPLACE_WITH_OPS_INBOX_FOLDER_ID", "mode": "id" },
        "event": "fileCreated",
        "options": {}
      }
    },
    {
      "id": "b1f0c6c2-0001-4a11-9a01-000000000002",
      "name": "Validate and load (Apps Script ETL)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "REPLACE_WITH_WEBAPP_URL",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'process_file', file_id: $json.id }) }}",
        "options": { "timeout": 360000 }
      }
    },
    {
      "id": "b1f0c6c2-0001-4a11-9a01-000000000003",
      "name": "Any rows rejected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c0000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.log.rows_rejected }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b1f0c6c2-0001-4a11-9a01-000000000004",
      "name": "Data steward agent (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, -100],
      "parameters": {
        "method": "POST",
        "url": "REPLACE_WITH_WEBAPP_URL",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'run_agent', agent: 'steward', file_name: $json.file }) }}",
        "options": { "timeout": 360000 }
      }
    },
    {
      "id": "b1f0c6c2-0001-4a11-9a01-000000000005",
      "name": "Clean file, nothing to explain",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [780, 100],
      "parameters": {}
    }
  ],
  "connections": {
    "New CSV in Ops Inbox": { "main": [[{ "node": "Validate and load (Apps Script ETL)", "type": "main", "index": 0 }]] },
    "Validate and load (Apps Script ETL)": { "main": [[{ "node": "Any rows rejected?", "type": "main", "index": 0 }]] },
    "Any rows rejected?": {
      "main": [
        [{ "node": "Data steward agent (Gemini)", "type": "main", "index": 0 }],
        [{ "node": "Clean file, nothing to explain", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Manila" },
  "pinData": {},
  "active": false
}
